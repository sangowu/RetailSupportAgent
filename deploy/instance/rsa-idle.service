[Unit]
Description=Stop this instance when nobody is using the demo
# After, but deliberately not Requires. The watcher has to run when the stack is broken,
# not only when it is healthy: an unreachable application is never counted as idle, so the
# machine stays up for someone to look at, and the uptime cap is what eventually stops it.
# Requiring rsa.service would tie the one thing that bounds the bill to the one thing that
# just failed.
After=rsa.service

[Service]
Type=oneshot
# Runs as root because it ends by stopping the machine. It reads one local URL and runs
# two commands; nothing here needs the network or a credential.
ExecStart=/usr/bin/python3 /opt/rsa/idle_shutdown.py
EnvironmentFile=-/etc/rsa-idle.env
TimeoutStartSec=300
