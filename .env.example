# Copy to .env and fill in. .env is excluded by .gitignore: keys must not be committed,
# and must not appear in logs, reports or summary.json.
#
# This file is organized by role, matching the three roles in evaluation.EvalStack:
#
#   agent under test  the model doing the work, and the one used in production
#   simulated user    plays the customer and sets the task
#   NL judge          decides whether natural-language assertions are met
#
# Each can run on a different platform. The same model can cost several times more on
# one platform than another (measured for deepseek-v4-pro: 0.133 CNY per task on
# DeepSeek off-peak, 0.391 on DashScope), so endpoints are configured per role rather
# than globally.
#
# Every endpoint group follows one rule: set all of it or none of it. A half-set group
# falls back to the shared endpoint below, and the resulting scores would be read as
# belonging to the new platform. The simulated user is the one exception: a missing
# value errors out instead of falling back, for the reason given in that section.


# -- required: shared endpoint --------------------------------------------
# The fallback. Any role without its own endpoint lands here.
# Currently carries: the reviewer model (qwen3.8-max, scripts/review_user_sim.py), and
# the previous simulated user qwen3.6-plus-2026-04-02 when reproducing older results.
DASHSCOPE_API_KEY=
RSA_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


# -- optional: separate endpoint for the agent under test ------------------
# M0.4 selected deepseek-v4-pro on DeepSeek's own endpoint, 3-5x cheaper than the same
# model on DashScope. The model id lives in code (config.SELECTED_MODEL) rather than the
# environment: it determines what a score means and must not be changed by a variable.
#
# Do not switch the model under test by editing RSA_OPENAI_BASE_URL; that would move the
# simulated user as well.
RSA_AGENT_BASE_URL=https://api.deepseek.com
RSA_AGENT_API_KEY=


# -- required: endpoint for the simulated user -----------------------------
# Required, not optional: since 2026-09-07 the frozen simulated user is glm-5.3-flash,
# which exists only on the Zhipu open platform. Without these three, EvalStack raises at
# construction. That is deliberate: a silent fallback to DashScope would leave the
# manifest saying glm-5.3-flash while a different model actually ran.
#
# This is the mainland service open.bigmodel.cn, not api.z.ai: different endpoints and
# different prices (the latter bills in USD).
#
# Why qwen3.6-plus was replaced: it put "please go change it" and ###STOP### in the same
# message, leaving the agent no turn in which to act. Paired over 24 tasks, 14/24 ->
# 23/24, p=0.0117. It also cut simulated-user cost from 1.09 to 0.10 CNY per 24 tasks.
# See docs/M0.4_EXPERIMENT_PLAN.md §9.8.
#
# glm-5.3-flash accepts reasoning_effort low / high / max only, and cannot disable
# thinking (sending disabled returns 400 code 1210), so run_eval.py's
# --user-no-thinking is unavailable with it and errors immediately.
RSA_USER_BASE_URL=https://open.bigmodel.cn/api/paas/v4
RSA_USER_API_KEY=
RSA_USER_MODEL=glm-5.3-flash


# -- optional: separate endpoint for the NL judge --------------------------
# Isolates quota from the agent under test, so exhausting the agent's account cannot
# take the judge down with it. The judge must be outside the candidate pool and not in
# the same family as the agent under test; otherwise it is self-preference, reported by
# EvalStack.warnings, which does not block a run but reaches the manifest and the report.
RSA_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RSA_JUDGE_API_KEY=
RSA_JUDGE_MODEL=qwen3.7-flash-2026-07-15


# -- optional: Langfuse cloud observability --------------------------------
# All three or none: a partial configuration is not used at all, because it would only
# surface mid-run. When configured, run_eval.py prints that Langfuse is enabled;
# otherwise it prints why it is not.
#
# The dashboard shows no cost. It is always 0 there, which is an upstream gap, not a
# free run. litellm 1.82.6's langfuse_otel never sends the cost fields, and letting
# Langfuse compute from usage does not work either: the usage it receives has no cache
# breakdown, while 95% of agent-side input is cache hits at 1/30 of the full rate, so
# full-price arithmetic overstates cost about 5x. A plausible wrong number is harder to
# notice than a zero. Cost comes from scripts/analyze_eval.py; see
# docs/M0.5_OBSERVABILITY.md §3.
#
# The dashboard is for traces, latency and tokens. Each run's traces are tagged with the
# run directory name as the session id, so searching that name under Tracing ->
# Sessions maps them back to the run. It is also in summary.json under
# observability.langfuse_session_id.
#
# Do not configure it the way upstream tau2 does: its callback name is "langfuse", which
# fails to initialize on the current SDK and is swallowed silently, producing no traces
# at all. This project uses "langfuse_otel".
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# -- application state database (M1) ---------------------------------------
# Application state only: sessions, messages, confirmations, write operations, audit.
# The τ²-bench simulated order data stays in upstream's in-memory environment.
#
# Local development: `docker compose up -d db` starts a PostgreSQL bound to the loopback
# interface, and the URL below points at it. A real environment injects its own URL
# through the environment and never commits it.
RSA_DATABASE_URL=postgresql+psycopg://rsa:rsa_local_dev@127.0.0.1:55432/rsa

# -- authentication (M3) ---------------------------------------------------
# Empty means authentication is off: the service keeps one fixed simulated identity,
# binds to the loopback interface and offers no registration. That is what the local
# demo and the evaluation loop run as, and neither goes through an identity provider.
#
# Setting the issuer and the audience together turns authentication on for every route,
# and the service then refuses to start without RSA_DATABASE_URL, because identities and
# roles are read from the database - never from the token's group claims.
#
# For a Cognito user pool (M6):
#   RSA_AUTH_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user pool id>
#   RSA_AUTH_AUDIENCE=<app client id>
# The key set is derived as <issuer>/.well-known/jwks.json unless RSA_AUTH_JWKS_URL says
# otherwise. None of these are secrets: they identify a pool, they do not open it.
#
# RSA_AUTH_TOKEN_USE is "access" for an access token and "id" for an id token. It must
# match what the client actually sends, or every request is refused.
RSA_AUTH_ISSUER=
RSA_AUTH_AUDIENCE=
RSA_AUTH_JWKS_URL=
RSA_AUTH_TOKEN_USE=access

# -- which version is running (M6.8) ---------------------------------------
# Reported by /health so that a rollback can be checked from the thing that is running
# rather than inferred from what was last applied. On the demo instance this is set by
# compose from a Parameter Store value; locally it is not needed and /health says
# "unknown".
RSA_IMAGE=

# -- human handoff and approval (M4) ---------------------------------------
# How long a supervisor's decision on an escalated action stays usable, in seconds.
# 1800 (30 minutes) is the default the architecture document fixes: long enough for
# someone to read the case, short enough that an authorization is not sitting in a table
# waiting to be used tomorrow. An expired decision authorizes nothing and the action has
# to be raised again.
RSA_APPROVAL_TTL_SECONDS=1800

# -- access scope: the slice of retail data a session may reach ------------
# The upstream dataset carries no tenant or sensitivity column, so both slices below are
# derived from fields the records already have. Reads are held to the authenticated
# identity's own data whenever the application path is used; these two settings narrow
# that further.
#
# Fields hidden from the model in every tool result, comma separated. Empty disables the
# column slice. The default hides the customer's email, which no tool takes as input.
# Adding payment_methods here will break returns and exchanges: they need the
# payment_method_id from the profile.
RSA_SCOPE_REDACT_FIELDS=email
# Order lifecycle stages a session may write to, comma separated: pending, processed,
# delivered, cancelled. Empty means every stage, which is the default because the
# upstream tools already restrict themselves - a cancellation needs a pending order and
# a return a delivered one, so naming one stage here would deny the other outright.
RSA_SCOPE_WRITE_STATUSES=
# Whether the model's answer is checked against what the turn actually read: identifiers
# it did not read are withheld from the reply. On by default. It is the riskiest of these
# controls - it can withhold an identifier from an answer that was in fact legitimate -
# so it has its own switch, and turning it off leaves the row and column slices in place.
RSA_SCOPE_CHECK_OUTPUT=true
