# 复制为 .env 后填写。.env 已被 .gitignore 排除——
# 密钥禁止提交，也禁止写进日志、报告或 summary.json。
#
# 本文件按**角色**组织，与 evaluation.EvalStack 的三个角色一一对应：
#
#   被测 Agent   跑业务的模型，也是线上要用的模型
#   模拟用户     扮演顾客、出考题
#   NL 判官      判定自然语言断言是否满足
#
# 三者各自可以跑在不同平台上。同一模型跨平台价差可达数倍
# （实测 deepseek-v4-pro：DeepSeek 官方谷时 0.133 元/题，DashScope 0.391 元/题），
# 所以端点是按角色配的，不是全局一个。
#
# 每组端点都遵循同一条规则：**要么整组都配，要么整组都不配**。
# 只配一半会退回下面的公共端点——那样跑出来的成绩会被误以为是新平台的。
# 模拟用户那组是唯一的例外：缺配会直接报错而不是退回（原因见该段）。


# ── 必填：公共端点 ───────────────────────────────────────────────
# 兜底端点。任何角色没有配独立端点时，都落到这里。
# 目前实际承载：审查判官（scripts/review_user_sim.py 的 qwen3.8-max），
# 以及复跑历史结论时显式指回的旧模拟用户 qwen3.6-plus-2026-04-02。
DASHSCOPE_API_KEY=
RSA_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


# ── 可选：被测 Agent 的独立端点 ──────────────────────────────────
# M0.4 选定 deepseek-v4-pro，走 DeepSeek 官方（比 DashScope 上的同款便宜 3~5 倍）。
# 模型 ID 在代码里（config.SELECTED_MODEL），不从环境读——它决定成绩口径，
# 不该被一个环境变量悄悄改掉。
#
# 注意：**不要靠改 RSA_OPENAI_BASE_URL 来切换被测模型**，
# 那会把模拟用户一起改掉。
RSA_AGENT_BASE_URL=https://api.deepseek.com
RSA_AGENT_API_KEY=


# ── 必填：模拟用户的端点 ────────────────────────────────────────
# 这组是**必填**，不是可选：2026-09-07 起冻结的模拟用户是 glm-5.3-flash，
# 它只在智谱开放平台上。不配这三项，EvalStack 会在构造时直接报错——
# 故意的，静默退回 DashScope 会让 manifest 写着 glm-5.3-flash、
# 实际跑的却是别的模型。
#
# 注意是**国内版 open.bigmodel.cn**，不是境外的 api.z.ai：
# 两者端点不同、价格也不同（境外按美元计）。
#
# 为什么换掉 qwen3.6-plus：它会把「请你去改」和 ###STOP### 写进同一条消息，
# Agent 根本没有回合执行动作。24 题配对 14/24 -> 23/24，p=0.0117。
# 顺带把模拟用户成本从 1.09 元/24 题降到 0.10 元。详见
# docs/M0.4_EXPERIMENT_PLAN.md §9.8。
#
# glm-5.3-flash 的 reasoning_effort 只接受 low / high / max，
# 且**不允许关闭思考**（传 disabled 会 400 code 1210）——
# 也就是说 run_eval.py 的 --user-no-thinking 对它不可用，会当场报错。
RSA_USER_BASE_URL=https://open.bigmodel.cn/api/paas/v4
RSA_USER_API_KEY=
RSA_USER_MODEL=glm-5.3-flash


# ── 可选：NL 判官的独立端点 ─────────────────────────────────────
# 额度与被测隔离：被测账户额度耗尽不会连带判官一起挂掉。
# 判官必须在候选池之外，且不与被测同家族（否则是自评偏袒，
# 见 EvalStack.warnings —— 它不阻断运行，但会进 manifest 和报告）。
RSA_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RSA_JUDGE_API_KEY=
RSA_JUDGE_MODEL=qwen3.7-flash-2026-07-15


# ── 未接入：Langfuse ────────────────────────────────────────────
# 这三个变量**目前没有任何代码读取**，配了也不会生效。
# 此前注释写「M0.2 起接入」，与事实不符，已更正。
#
# 接入前必须先做一步：用 litellm.register_model() 把 pricing.py 的价格快照
# 注册进 litellm。否则 litellm 不认识这些型号，completion_cost() 抛异常后
# 返回 0.0（这正是 summary.json 里 agent_cost 恒为 0 的原因），
# Langfuse 面板会显示「每次调用 0 元」——
# 恰好违反 docs/EVALUATION_AND_GATES.md 自己写下的禁令：
# 「未核验价格时不能把缺失成本记为免费」。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
