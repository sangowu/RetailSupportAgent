{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retail-support-agent.local/schemas/task_result.json",
  "title": "Per-task raw result",
  "description": "The raw record of one trial of one task. Business failures, service errors and unsupported parameters must be stored under distinct categories and never discarded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "task_id", "trial", "outcome", "reward", "usage", "timing"],
  "properties": {
    "run_id": { "type": "string" },
    "task_id": { "type": "string" },
    "trial": { "type": "integer", "minimum": 0 },
    "scope_label": {
      "type": "string",
      "enum": ["read_only", "in_scope_write", "out_of_scope_write", "no_action"],
      "description": "From evaluation/task_sets/scope_labels.json; used for layered reporting only"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "task_failure",
        "policy_violation",
        "service_error",
        "unsupported_param",
        "timeout",
        "truncated",
        "max_steps_exceeded"
      ],
      "description": "Business failure, service error and unsupported parameter must stay distinct and must not be merged into a single failure rate"
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "components"],
      "properties": {
        "total": { "type": "number", "minimum": 0, "maximum": 1 },
        "components": {
          "type": "object",
          "description": "Upstream component rewards (DB, NL_ASSERTION and so on); total is their product over reward_basis",
          "additionalProperties": { "type": "number" }
        },
        "reward_basis": { "type": "array", "items": { "type": "string" } }
      }
    },
    "termination_reason": { "type": ["string", "null"] },
    "usage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["input_tokens", "output_tokens"],
      "description": "The actual usage returned by the server; thinking and cached tokens are listed separately when billed separately",
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": ["integer", "null"] },
        "cached_input_tokens": { "type": ["integer", "null"] }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds"],
      "properties": {
        "wall_seconds": { "type": "number", "minimum": 0 },
        "agent_seconds": {
          "type": ["number", "null"],
          "description": "Agent time with the simulated user and judge time subtracted"
        }
      }
    },
    "retries": { "type": "integer", "minimum": 0 },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string" },
        "http_status": { "type": ["integer", "null"] }
      }
    },
    "trajectory_ref": {
      "type": ["string", "null"],
      "description": "Archive path of the full conversation trace, or a Langfuse trace id"
    }
  }
}
