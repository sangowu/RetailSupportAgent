{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retail-support-agent.local/schemas/run_manifest.json",
  "title": "Evaluation run manifest",
  "description": "A complete, reproducible description of one evaluation run. A run missing any required field must not enter a comparison report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "started_at",
    "purpose",
    "code",
    "upstream",
    "task_set",
    "agent",
    "user_simulator",
    "judge",
    "execution"
  ],
  "properties": {
    "run_id": { "type": "string", "description": "Globally unique; a UTC timestamp plus a short hash is recommended" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "purpose": {
      "type": "string",
      "enum": [
        "capability_check",
        "screening",
        "budget_sweep",
        "holdout_validation",
        "regression",
        "baseline_freeze"
      ],
      "description": "Purpose of the run. The task set used by holdout_validation must not be used for tuning."
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "dirty"],
      "properties": {
        "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty": {
          "type": "boolean",
          "description": "True when the working tree has uncommitted changes; such a run must not be the basis of a freeze"
        },
        "lockfile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "verified"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "verified": {
          "type": "boolean",
          "description": "Whether the SHA256 verification passed before the run; false invalidates the results"
        }
      }
    },
    "task_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "task_ids", "trials_per_task"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["dev", "holdout", "regression", "dev_subset"]
        },
        "subset_rule": {
          "type": ["string", "null"],
          "description": "Sampling rule when a subset is used; it must be reproducible"
        },
        "task_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "trials_per_task": { "type": "integer", "minimum": 1 }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "base_url", "requested_params", "prompt_sha256"],
      "properties": {
        "model_id": { "type": "string", "description": "The exact model id sent in the request" },
        "response_model_id": {
          "type": ["string", "null"],
          "description": "The model id the server actually returned, which may differ from the request"
        },
        "base_url": { "type": "string" },
        "requested_params": {
          "type": "object",
          "description": "The parameters actually sent, recorded verbatim, including temperature/top_p/max_tokens and the thinking switch and budget",
          "additionalProperties": true
        },
        "param_acceptance": {
          "type": "object",
          "description": "Per-parameter accepted/rejected/ignored/mapped status; HTTP 200 is not proof a parameter took effect",
          "additionalProperties": {
            "type": "string",
            "enum": ["accepted", "rejected", "ignored", "mapped", "unverified"]
          }
        },
        "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "user_simulator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "params", "guidelines_sha256"],
      "description": "The simulated user must be frozen and must not change together with the agent model under test",
      "properties": {
        "model_id": { "type": "string" },
        "params": { "type": "object", "additionalProperties": true },
        "guidelines_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nl_assertion_model_id", "params"],
      "description": "The NL assertion judge model must likewise be frozen and must not be relaxed for a candidate implementation",
      "properties": {
        "nl_assertion_model_id": { "type": "string" },
        "params": { "type": "object", "additionalProperties": true }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_steps", "timeout_seconds", "concurrency", "interleaved_with"],
      "properties": {
        "max_steps": { "type": "integer", "minimum": 1 },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "interleaved_with": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Other run_ids interleaved in the same batch, showing that caching and rate-limiting conditions are comparable"
        },
        "seed": { "type": ["integer", "null"] },
        "retry_policy": { "type": ["string", "null"] }
      }
    },
    "pricing_snapshot": {
      "type": "object",
      "description": "The unit prices used for cost conversion with their source and date; without them a cost conclusion does not hold",
      "additionalProperties": true
    },
    "langfuse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_ids": { "type": "array", "items": { "type": "string" } },
        "session_id": { "type": ["string", "null"] }
      }
    },
    "notes": { "type": "string" }
  }
}
