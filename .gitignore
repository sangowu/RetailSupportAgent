# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Secrets: never enter Git under any circumstance
.env
.env.*
!.env.example
*.key

# Upstream benchmark is fetched at a pinned commit, not committed (see scripts/fetch_tau2.py)
third_party/

# Evaluation results: per-turn conversation traces are large (about 100KB per task) and are
# not committed by default; each run's summary.json must be committed, or the numbers in a
# report cannot be traced back to a specific run.
# Upstream treats save_to as a directory, so raw traces land in <name>.json/ at about 100KB
# per task and are not committed.
# Use a wildcard rather than hard-coding simulations.json: an early stop writes phase1.json/
# and phase2.json/, and a hard-coded name lets those directories slip through (it happened).
evaluation/results/**/*.json/
# These two must be committed: every number in a report has to trace back to a run.
!evaluation/results/**/summary.json
!evaluation/results/**/judge_recheck_*.json

# Runtime artefacts of local start/stop: the process registry (PID + start time) and service
# logs. The registry is machine-specific and the logs may contain request content.
.local/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Terraform. State names live resources and can hold values that were passed to it; plans
# and .tfvars carry the same. The provider cache is large and machine-specific.
# .terraform.lock.hcl is deliberately NOT here: it pins provider versions and hashes,
# and belongs in version control for the same reason uv.lock does.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.auto.tfvars
terraform.tfvars

# The MCP acceptance run CI keeps as an artifact. Dated reports in the same directory
# are committed; this one is rewritten on every run.
reports/mcp_acceptance/ci.json
